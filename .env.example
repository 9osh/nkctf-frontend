# Backend API base URL
# This will be used to proxy /api/* requests to the backend server
#
# Development (default):
# NUXT_PUBLIC_API_BASE=http://localhost:8080
#
# Production examples:
# NUXT_PUBLIC_API_BASE=https://api.nkctf.com
# NUXT_PUBLIC_API_BASE=http://192.168.1.100:8080

NUXT_PUBLIC_API_BASE=http://localhost:8080
